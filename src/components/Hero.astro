---
const personalImageAlt = "José Antonio León López";
import Badge from "@/components/Badge.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import GitHubIcon from "@/components/icons/GitHub.astro";
import MailIcon from "@/components/icons/Mail.astro";
import SocialPill from "@/components/SocialPill.astro";
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-16 object-cover object-top"
      src="joseantonio.png"
      alt={personalImageAlt}
    />
    <a
      href="https://www.linkedin.com/in/jose-antonio-leon-lopez/"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Abierto a nuevas oportunidades</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    Hola, soy José Antonio León.
  </h1>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    +3 años de experiencia. <strong
      >Full-Stack Software Engineer especializado en Java, Spring Boot y React,
      con experiencia integrando soluciones de Inteligencia Artificial</strong
    > en Sevilla, España 🇪🇸. Diseño microservicios escalables y seguros, e interfaces
    de alto rendimiento, aportando resultados medibles en entornos Agile/Scrum.
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:joseantonioleonlopez206@gmail.com">
      <MailIcon class="size-4" />
      Contáctame
    </SocialPill>
    <SocialPill href="https://www.linkedin.com/in/jose-antonio-leon-lopez/">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/JoseAntonioLeonLopez">
      <GitHubIcon class="size-4" />
      GitHub
    </SocialPill>
  </nav>
</div>
